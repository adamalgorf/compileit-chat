# Copy to .env. Secrets are not kept in code; see README "Accounts, history and secrets".

# --- Secrets ----------------------------------------------------------------------------
# Encrypts secrets stored in the database. Generate: `compileit-chat new-master-key`
# (Docker: `docker compose run --rm api compileit-chat new-master-key`). Keep it out of git.
SECRETS_MASTER_KEY=
# Preferred: store the OpenAI key encrypted in the database with
#   compileit-chat set-secret openai_api_key
# This variable is only a fallback (e.g. for local development or CI).
OPENAI_API_KEY=

# --- Database & login -------------------------------------------------------------------
# DATABASE_URL=                   # default: SQLite file backend/data/runtime/app.sqlite3
# AUTH_SESSION_HOURS=12
# AUTH_COOKIE_SECURE=false        # set true when served over HTTPS

# --- Models -----------------------------------------------------------------------------
# CHAT_MODEL=gpt-4.1-mini
# CHAT_TEMPERATURE=0.1
# EMBEDDING_MODEL=text-embedding-3-small   # changing it requires `make index`

# --- Agent guard rails ------------------------------------------------------------------
# AGENT_MAX_TOOL_ITERATIONS=4     # tool rounds per turn, then a polite fallback answer
# AGENT_TIMEOUT_SECONDS=60
# HISTORY_MAX_MESSAGES=20         # earlier-turn messages sent to the model

# --- Retrieval --------------------------------------------------------------------------
# RETRIEVAL_VECTOR_CANDIDATES=20
# RETRIEVAL_LEXICAL_CANDIDATES=3  # BM25 hits fused with vector hits (see ADR-0003)

# --- API --------------------------------------------------------------------------------
# API_CORS_ORIGINS=["http://localhost:3000"]
# API_RATE_LIMIT_REQUESTS=20      # chat requests per client per window
# API_RATE_LIMIT_WINDOW_SECONDS=60
# LOG_LEVEL=INFO

# --- Optional tracing (LangSmith) -------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=compileit-chat
